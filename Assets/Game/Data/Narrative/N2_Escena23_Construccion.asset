  m_Script: {fileID: 11500000, guid: fe39808d68b138e4fb74e8e86cb55219, type: 3}
  m_Name: N2_Escena23_Construccion
  m_EditorClassIdentifier: Game.Scaffolding::Game.Scaffolding.NarrativeSequence
  <Id>k__BackingField: N2_Escena23_Construccion
  <Level>k__BackingField: 2
  <Illustration>k__BackingField: {fileID: 0}
  <IsReflectiveClosing>k__BackingField: 0
  <Lines>k__BackingField:
  - <Speaker>k__BackingField: "NI\xD1A"
    <Text>k__BackingField: Si hacemos algo redondo... podemos usarlo.
  - <Speaker>k__BackingField: "PAP\xC1"
    <Text>k__BackingField: Construyamos uno.
  - <Speaker>k__BackingField: "NI\xD1O"
    <Text>k__BackingField: "\xA1Probemos!"
  - <Speaker>k__BackingField: "MAM\xC1"
    <Text>k__BackingField: Paso a paso... podemos lograrlo.
  - <Speaker>k__BackingField: CHISPA
    <Text>k__BackingField: "Abre agujeros en el centro de los troncos cortos, luego \xFAnelos con el tronco largo."
  - <Speaker>k__BackingField: CHISPA
    <Text>k__BackingField: Coloca encima la tabla y sobre ella la caja de alimentos.
  - <Speaker>k__BackingField: CHISPA
    <Text>k__BackingField: "En ese orden: cada paso necesita que el anterior est\xE9 hecho."
