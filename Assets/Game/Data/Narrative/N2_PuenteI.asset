  <Lines>k__BackingField:
  - <Speaker>k__BackingField: 
    <Text>k__BackingField: "Amanece. La familia sale de la cueva. ALGORITM flota
      sobre las brasas que a\xFAn humean."
    <Sound>k__BackingField: {fileID: 0}
    <Ambient>k__BackingField: {fileID: 0}
    <Silence>k__BackingField: 0
  - <Speaker>k__BackingField: ALGORITM
    <Text>k__BackingField: "Ahora que tienen fuego, pueden cocinar. Pero para cocinar
      hace falta algo m\xE1s."
    <Sound>k__BackingField: {fileID: 0}
    <Ambient>k__BackingField: {fileID: 0}
