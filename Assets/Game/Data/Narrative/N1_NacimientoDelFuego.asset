MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: fe39808d68b138e4fb74e8e86cb55219, type: 3}
  m_Name: N1_NacimientoDelFuego
  m_EditorClassIdentifier: Game.Scaffolding::Game.Scaffolding.NarrativeSequence
  <Id>k__BackingField: N1_NacimientoDelFuego
  <Level>k__BackingField: 1
  <Illustration>k__BackingField: {fileID: 0}
  <IsReflectiveClosing>k__BackingField: 1
  <NextPhase>k__BackingField: 0
  <Lines>k__BackingField:
  - <Speaker>k__BackingField:
    <Text>k__BackingField: "Una llama naranja y dorada crece despacio desde las hojas."
  - <Speaker>k__BackingField:
    <Text>k__BackingField: "Es temblorosa al principio, y después más firme y alta."
  - <Speaker>k__BackingField:
    <Text>k__BackingField: "La cueva entera se llena de luz y calor en segundos."
  - <Speaker>k__BackingField:
    <Text>k__BackingField: "Papá se queda quieto, arrodillado, mirando las llamas."
  - <Speaker>k__BackingField: "NIÑOS"
    <Text>k__BackingField: "¡Papáaaa! ¡Lo lograste!"
  - <Speaker>k__BackingField:
    <Text>k__BackingField: "Los niños corren y se lanzan encima de él."
  - <Speaker>k__BackingField:
    <Text>k__BackingField: "Mamá llega detrás, riendo y llorando al mismo tiempo."
  - <Speaker>k__BackingField:
    <Text>k__BackingField: "Papá los abraza a todos mientras el fuego crepita."
  - <Speaker>k__BackingField:
    <Text>k__BackingField: "La cueva oscura se convierte en el lugar más cálido del mundo."
  - <Speaker>k__BackingField: "PAPÁ"
    <Text>k__BackingField: "Las piedras tenían razón. Eran especiales."
  - <Speaker>k__BackingField:
    <Text>k__BackingField: "En el corazón de las llamas aparece una silueta pequeña."
  - <Speaker>k__BackingField:
    <Text>k__BackingField: "Es Chispa, brillando más que nunca, hecho de fuego esta vez."
  - <Speaker>k__BackingField: "CHISPA"
    <Text>k__BackingField: "¿Ven? Yo no traje la luz. Solo les mostré dónde buscar.
      El resto lo hizo papá."
  - <Speaker>k__BackingField: "NIÑA"
    <Text>k__BackingField: "Papá, ¡tú eres como Chispa!"
  - <Speaker>k__BackingField:
    <Text>k__BackingField: "Papá se ríe bajito y la abraza más fuerte."
  - <Speaker>k__BackingField: "CHISPA"
    <Text>k__BackingField: "Y algo más. La primera vez no funcionó, ni la segunda.
      Cambiaste de lugar, volviste a probar y miraste qué pasaba cada vez."
  - <Speaker>k__BackingField: "CHISPA"
    <Text>k__BackingField: "Eso tiene nombre: se llama iterar. Probar, mirar el resultado
      y ajustar."
  - <Speaker>k__BackingField:
    <Text>k__BackingField: "Chispa parpadea tres veces y se recoge dentro de la fogata,
      como una brasa viva."
  - <Speaker>k__BackingField:
    <Text>k__BackingField: "Esa noche la familia duerme caliente y unida."
