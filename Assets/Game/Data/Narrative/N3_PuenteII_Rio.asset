  <Lines>k__BackingField:
  - <Speaker>k__BackingField: 
    <Text>k__BackingField: "La familia avanza con la carretilla. El camino se corta
      abruptamente. Frente a ellos: el r\xEDo, ancho y de corriente visible."
    <Sound>k__BackingField: {fileID: 0}
    <Ambient>k__BackingField: {fileID: 0}
    <Silence>k__BackingField: 0
  - <Speaker>k__BackingField: "NI\xD1O"
    <Text>k__BackingField: "\xA1La carretilla no sirve aqu\xED!"
    <Sound>k__BackingField: {fileID: 0}
    <Ambient>k__BackingField: {fileID: 0}
    <Silence>k__BackingField: 0
  - <Speaker>k__BackingField: "MAM\xC1"
    <Text>k__BackingField: Necesitamos cruzar primero.
    <Sound>k__BackingField: {fileID: 0}
    <Ambient>k__BackingField: {fileID: 0}
    <Silence>k__BackingField: 0
  - <Speaker>k__BackingField: ALGORITM
    <Text>k__BackingField: "Exacto. La rueda los trajo hasta ac\xE1. Pero este problema
      es diferente. Hay que pensar de nuevo."
    <Sound>k__BackingField: {fileID: 0}
    <Ambient>k__BackingField: {fileID: 0}
    <Silence>k__BackingField: 0
