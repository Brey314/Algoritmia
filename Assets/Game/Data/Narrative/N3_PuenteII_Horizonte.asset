  <Lines>k__BackingField:
  - <Speaker>k__BackingField: 
    <Text>k__BackingField: "La c\xE1mara se desplaza hacia el horizonte. A lo lejos
      se ven las fogatas de la civilizaci\xF3n."
    <Sound>k__BackingField: {fileID: 0}
    <Ambient>k__BackingField: {fileID: 0}
    <Silence>k__BackingField: 0
  - <Speaker>k__BackingField: "NI\xD1A"
    <Text>k__BackingField: "\xBFQu\xE9 es eso?"
    <Sound>k__BackingField: {fileID: 0}
    <Ambient>k__BackingField: {fileID: 0}
    <Silence>k__BackingField: 0
  - <Speaker>k__BackingField: ALGORITM
    <Text>k__BackingField: "Otros como ustedes. M\xE1s adelante. Un lugar donde ya
      saben cultivar, construir y vivir juntos."
    <Sound>k__BackingField: {fileID: 0}
    <Ambient>k__BackingField: {fileID: 0}
    <Silence>k__BackingField: 0
  - <Speaker>k__BackingField: "PAP\xC1"
    <Text>k__BackingField: "\xBFPodemos llegar?"
    <Sound>k__BackingField: {fileID: 0}
    <Ambient>k__BackingField: {fileID: 0}
    <Silence>k__BackingField: 0
  - <Speaker>k__BackingField: ALGORITM
    <Text>k__BackingField: "El camino existe\u2026 pero hay un problema."
    <Sound>k__BackingField: {fileID: 0}
    <Ambient>k__BackingField: {fileID: 0}
    <Silence>k__BackingField: 0
