%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2991c473d81d30c47962fa1639427b06, type: 3}
  m_Name: N1_Guia
  m_EditorClassIdentifier: Game.Scaffolding::Game.Scaffolding.GuideContent
  <Level>k__BackingField: 1
  <Steps>k__BackingField:
  - <Id>k__BackingField: Reunir
    <Instruction>k__BackingField: "Reúne todas las hojas y las dos piedras en el centro de la
      pantalla."
    <Hint>k__BackingField: "Todo tiene que quedar dentro del círculo. ¿Qué pieza sigue
      fuera?"
  - <Id>k__BackingField: Golpear
    <Instruction>k__BackingField: "Elige la fuerza y qué tan cerca van las piedras, y golpea
      para hacer chispas."
    <Hint>k__BackingField: "Las chispas dependen de cómo chocan las piedras: de la fuerza y de
      qué tan juntas están. ¿Qué cambiarías antes del próximo golpe?"
  - <Id>k__BackingField: Soplar
    <Instruction>k__BackingField: "Sopla despacio sobre el montón de hojas para avivar el humo."
    <Hint>k__BackingField: "El humo ya está ahí. ¿Está todo junto y cerca? ¿Qué le falta para
      volverse llama?"
